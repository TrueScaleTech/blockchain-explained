---
import Base from '../../layouts/Base.astro';
import { LOCALES, STRINGS, type Locale } from '../../i18n';
import { getLessons, slugOf } from '../../lessons';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = STRINGS[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lessons = await getLessons(locale);
const first = lessons[0];
const pad = (n: number) => String(n).padStart(2, '0');
const edition = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric' }).format(
  new Date(),
);
---

<Base locale={locale} path="" current="lessons">
  <article>
    <dl class="hdr">
      <div>
        <dt>{t.hdrSeries}</dt>
        <dd>{t.siteTitle}</dd>
      </div>
      <div>
        <dt>{t.hdrEdition}</dt>
        <dd>{edition}</dd>
      </div>
    </dl>
    <section class="lead">
      <h1>
        <span class="index-title">{t.siteTitle}</span>
      </h1>
      <p>{t.intro}</p>
      {first && (
        <a class="btn" href={`${base}/${locale}/lessons/${slugOf(first)}/`}>
          {t.start}
        </a>
      )}
    </section>
    <h2 class="sr-only">{t.lessonsHeading}</h2>
    <ol class="reel">
      {lessons.map((lesson) => (
        <li>
          <a href={`${base}/${locale}/lessons/${slugOf(lesson)}/`}>
            <span class="n">{pad(lesson.data.order)}</span>
            <h3>{lesson.data.title}</h3>
            <span class="go" aria-hidden="true">
              {t.open} →
            </span>
            <p>{lesson.data.summary}</p>
          </a>
        </li>
      ))}
    </ol>
  </article>
</Base>
