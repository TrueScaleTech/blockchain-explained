---
import { isLocale } from '../../i18n';
import { GENESIS_PREVIOUS_HASH, computeChain, mineBlock } from '../../lib/block';
import { WIDGET_STRINGS, fill } from '../../widget-strings';
import Bench from './Bench.astro';

const DIFFICULTY = 3;
const locale = isLocale(Astro.params.lang) ? Astro.params.lang : 'en';
const s = WIDGET_STRINGS[locale].chain;

// Mine the starting chain at build time: the static page shows a real, valid chain.
const inputs: { data: string; nonce: number }[] = [];
let previousHash = GENESIS_PREVIOUS_HASH;
for (const [index, data] of s.datas.entries()) {
  const result = await mineBlock(index, previousHash, data, DIFFICULTY, { pause: async () => {} });
  if (!result) throw new Error('mining the starting chain failed');
  inputs.push({ data, nonce: result.nonce });
  previousHash = result.hash;
}
const chain = await computeChain(inputs, DIFFICULTY);
const short = (hash: string) => `${hash.slice(0, 14)}…`;
const zeros = '0'.repeat(DIFFICULTY);
---

<Bench
  name="chain"
  locale={locale}
  title={s.title}
  hint={s.hint}
  strings={{ ...s, difficulty: DIFFICULTY }}
>
  <p class="rule">{fill(s.rule, { zeros })}</p>
  <ol class="chain">
    {chain.map((block) => (
      <li class="block" data-index={block.index} data-valid={String(block.valid)}>
        <svg class="cross" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <line x1="10" y1="10" x2="90" y2="90" pathLength="100" />
          <line x1="90" y1="10" x2="10" y2="90" pathLength="100" />
        </svg>
        <div class="block-head">
          <span class="lab">
            {s.block} {block.index + 1}
          </span>
          <span class="status">{block.valid ? s.valid : s.broken}</span>
        </div>
        <label class="lab" for={`chain-data-${block.index}`}>
          {s.data}
          <span class="sr-only">
            · {s.block} {block.index + 1}
          </span>
        </label>
        <p class="data-static">{block.data}</p>
        <textarea
          id={`chain-data-${block.index}`}
          class="data live"
          rows="2"
          maxlength="80"
          spellcheck="false"
          hidden
        >
            {block.data}
          </textarea>
        <dl>
          <dt>{s.nonce}</dt>
          <dd class="nonce">{block.nonce}</dd>
          <dt>{s.prev}</dt>
          <dd class="prev">{short(block.previousHash)}</dd>
          <dt>{s.hash}</dt>
          <dd class="hash">{short(block.hash)}</dd>
        </dl>
        <button
          class="btn mine live"
          type="button"
          hidden
          aria-label={`${s.mine} · ${s.block} ${block.index + 1}`}
        >
          {s.mine}
        </button>
      </li>
    ))}
  </ol>
  <p class="readout" aria-live="polite">
    <span class="verdict">{s.allValid}</span>
  </p>
</Bench>

<script>
  import { computeChain, firstInvalid, mineBlock, type Block } from '../../lib/block';
  import type { WidgetStrings } from '../../widget-strings';
  import { $, fill, goLive, latest, numberFormat, widgets, writeMarked } from './client';

  type Strings = WidgetStrings['chain'] & { difficulty: number };

  for (const { root, s } of widgets<Strings>('chain')) {
    const blocks = [...root.querySelectorAll<HTMLElement>('.block')];
    const verdict = $(root, '.verdict');
    const format = numberFormat();
    const turn = latest();
    const inputs = blocks.map((el) => ({
      data: $<HTMLTextAreaElement>(el, '.data').value.trim(),
      nonce: Number($(el, '.nonce').textContent),
    }));
    let busy = false;
    let chain: Block[] = [];

    const short = (hash: string) => `${hash.slice(0, 14)}…`;

    const render = () => {
      chain.forEach((block, i) => {
        const el = blocks[i]!;
        el.dataset.valid = String(block.valid);
        $(el, '.status').textContent = block.valid ? s.valid : s.broken;
        $(el, '.nonce').textContent = format.format(block.nonce);
        $(el, '.prev').textContent = short(block.previousHash);
        writeMarked($(el, '.hash'), short(block.hash), (j) => block.valid && j < s.difficulty);
      });
      const broken = firstInvalid(chain);
      verdict.textContent = broken === null ? s.allValid : fill(s.brokenFrom, { n: broken + 1 });
    };

    const update = async () => {
      const t = turn.next();
      const next = await computeChain(inputs, s.difficulty);
      if (!turn.isCurrent(t)) return;
      chain = next;
      render();
    };

    blocks.forEach((el, i) => {
      const area = $<HTMLTextAreaElement>(el, '.data');
      area.value = inputs[i]!.data;
      $(el, '.data-static').remove();
      area.addEventListener('input', () => {
        inputs[i]!.data = area.value;
        void update();
      });
      const button = $<HTMLButtonElement>(el, '.mine');
      button.addEventListener('click', async () => {
        if (busy) return;
        busy = true;
        root.querySelectorAll<HTMLButtonElement>('.mine').forEach((b) => (b.disabled = true));
        el.setAttribute('aria-busy', 'true');
        const block = chain[i]!;
        const result = await mineBlock(i, block.previousHash, inputs[i]!.data, s.difficulty, {
          startNonce: 0,
          onProgress: (n) => (button.textContent = `${s.mining} ${format.format(n)}`),
        });
        if (result) inputs[i]!.nonce = result.nonce;
        button.textContent = s.mine;
        el.removeAttribute('aria-busy');
        root.querySelectorAll<HTMLButtonElement>('.mine').forEach((b) => (b.disabled = false));
        busy = false;
        await update();
      });
    });

    goLive(root);
    void update();
  }
</script>
