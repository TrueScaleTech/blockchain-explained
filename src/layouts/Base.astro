---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import { STRINGS, otherLocale, type Locale } from '../i18n';

// The switch always reads IT | EN, whichever language the page is in.
const SWITCH_ORDER: Locale[] = ['it', 'en'];

interface Props {
  locale: Locale;
  /** The page's path after the language folder, e.g. "" or "about/" or "lessons/hash/". */
  path: string;
  current?: 'lessons' | 'about';
  title?: string;
  description?: string;
}

const { locale, path, current, title, description } = Astro.props;
const t = STRINGS[locale];
const other = otherLocale(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = title ? `${title} · ${t.siteTitle}` : t.siteTitle;
const pageDescription = description ?? t.tagline;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <!-- The page loads only its own files: no other origin, no inline script, no frames. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'"
    />
    <meta name="theme-color" content="#f4f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1116" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" hreflang={locale} href={`${base}/${locale}/${path}`} />
    <link rel="alternate" hreflang={other} href={`${base}/${other}/${path}`} />
    <script is:inline src={`${base}/theme.js`}></script>
  </head>
  <body>
    <a class="skip" href="#content">
      {t.skip}
    </a>
    <header class="mast">
      <div class="wrap">
        <a class="brand" href={`${base}/${locale}/`}>
          <svg viewBox="0 0 46 14" aria-hidden="true">
            <rect x="0.5" y="2.5" width="9" height="9" fill="none" stroke="currentColor"></rect>
            <rect x="18.5" y="2.5" width="9" height="9" fill="none" stroke="currentColor"></rect>
            <rect
              x="36.5"
              y="2.5"
              width="9"
              height="9"
              fill="currentColor"
              stroke="currentColor"
            ></rect>
            <line x1="10" y1="7" x2="18" y2="7" stroke="currentColor" stroke-width="2"></line>
            <line x1="28" y1="7" x2="36" y2="7" stroke="currentColor" stroke-width="2"></line>
          </svg>
          {t.siteTitle}
        </a>
        <nav aria-label={t.navLinks}>
          <a href={`${base}/${locale}/`} aria-current={current === 'lessons' ? 'page' : undefined}>
            {t.navLessons}
          </a>
          <a
            href={`${base}/${locale}/about/`}
            aria-current={current === 'about' ? 'page' : undefined}
          >
            {t.navAbout}
          </a>
          <!-- One link for the whole IT | EN mark: a click anywhere on it switches language. -->
          <a
            class="lang"
            href={`${base}/${other}/${path}`}
            lang={other}
            hreflang={other}
            aria-label={t.switchLanguage}
          >
            {SWITCH_ORDER.map((code, i) => (
              <>
                {i > 0 && <span aria-hidden="true">|</span>}
                <span
                  class="code"
                  aria-hidden="true"
                  data-current={code === locale ? 'true' : undefined}
                >
                  {code.toUpperCase()}
                </span>
              </>
            ))}
          </a>
          <button
            type="button"
            class="theme"
            id="theme-toggle"
            hidden
            data-to-dark={t.toDarkTheme}
            data-to-light={t.toLightTheme}
          >
            <svg
              class="icon-moon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
            </svg>
            <svg
              class="icon-sun"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <div class:list={['wrap', 'frame', !Astro.slots.has('contents') && 'solo']}>
      <slot name="contents" />
      <main id="content" class="doc">
        <slot />
      </main>
    </div>
    <footer class="site">
      <div class="wrap">
        <span>{t.footer}</span>
        <nav aria-label={t.navLinks}>
          <a href={`${base}/${locale}/about/`}>{t.navAbout}</a>
          <a href="https://github.com/TrueScaleTech/blockchain-explained" rel="noopener noreferrer">
            GitHub
          </a>
        </nav>
      </div>
    </footer>
    <script>
      // The toggle exists only for readers whose browser runs this script; without it the page
      // follows the system theme.
      const button = document.getElementById('theme-toggle');
      if (button) {
        button.hidden = false;
        const root = document.documentElement;
        const system = window.matchMedia('(prefers-color-scheme: dark)');
        const current = () => root.dataset.theme || (system.matches ? 'dark' : 'light');
        const sync = () => {
          const dark = current() === 'dark';
          button.dataset.state = dark ? 'dark' : 'light';
          button.setAttribute(
            'aria-label',
            (dark ? button.dataset.toLight : button.dataset.toDark) ?? '',
          );
        };
        button.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {
            // Storage can be blocked; the choice then lasts for this page only.
          }
          sync();
        });
        system.addEventListener('change', sync);
        sync();
      }
    </script>
  </body>
</html>
